{
  "name": "dotfiles",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "dev",
  "workspaceFolder": "/home/dev/code/dotfiles",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/dev/code/dotfiles,type=bind",
  "containerEnv": {
    "GIT_NAME": "Dev",
    "GIT_EMAIL": "dev@example.com"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "dev.containers.copyGitConfig": false
      },
      "extensions": [
        "timonwong.shellcheck",
        "foxundermoon.shell-format"
      ]
    }
  },
  "postCreateCommand": "./bootstrap.sh"
}
