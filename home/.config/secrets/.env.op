# Secrets for every repo, as 1Password references: no values are stored here.
# `secrets-refresh` resolves them into ~/.config/secrets/.env (mode 600,
# untracked), which every new shell loads. Repos list the names they read in
# .env.example.
#
# One line per variable: NAME= then the reference (vault/item/field) in double
# braces, single-quoted so the shell reads the value verbatim. op inject
# resolves references in comments too, so keep examples out of them. Items are
# referenced by ID, so renaming one in 1Password doesn't break this.

# --- Model providers ---

OPENROUTER_API_KEY='{{ op://Developer/cpsq63dnqjejzida3i6toxt2ry/credential }}'
REPLICATE_API_TOKEN='{{ op://Developer/js5pmt5oophxny3tjbmw4ww2n4/credential }}'

# --- GitHub ---

# Not GITHUB_TOKEN or GH_TOKEN: gh would use either in place of its own login
GITHUB_PAT='{{ op://Developer/okrswoyngccgugv6fpadmcslwq/token }}'

# --- Reading and bookmarks ---

READWISE_TOKEN='{{ op://Developer/ccxkg4ikhhbwylktvaj2yft22m/credential }}'
HYPOTHESIS_API_KEY='{{ op://Developer/xhtfkje64jbivuyktmzytd3udy/credential }}'
RAINDROP_CLIENT_ID='{{ op://Developer/drv2kii22lynwmn3kj2sos6oae/client ID }}'
RAINDROP_CLIENT_SECRET='{{ op://Developer/drv2kii22lynwmn3kj2sos6oae/client secret }}'
RAINDROP_TOKEN='{{ op://Developer/drv2kii22lynwmn3kj2sos6oae/token }}'

# --- X ---

X_CLIENT_ID='{{ op://Developer/eovarxjuob6untt5crrccojady/client id }}'
X_CLIENT_SECRET='{{ op://Developer/eovarxjuob6untt5crrccojady/client secret }}'

# --- Storage ---

# Cloudflare R2's S3 API (memex snapshots)
R2_ACCESS_KEY_ID='{{ op://Developer/2ssh5w5ou4jo6qf3znyoi235bi/s3 access key ID }}'
R2_SECRET_ACCESS_KEY='{{ op://Developer/2ssh5w5ou4jo6qf3znyoi235bi/s3 secret access key }}'

# --- Publishing ---

# Left out on purpose: every shell and agent would be able to publish to PyPI.
# Pass it to a single command instead: UV_PUBLISH_TOKEN="$(op read ...)" uv publish
