{
  "title": "Windows parity",
  "rules": [
    {
      "description": "Windows text navigation: Ctrl+Left/Right jumps words, Ctrl+Backspace/Delete deletes words, Home/End go to line start/end, Ctrl+Home/End go to document start/end, Ctrl+Y redoes (Ctrl is Cmd on the NuPhy macOS layers). Order matters: Ctrl+Home/End and word jump must come before Home/End, which output Cmd+Left/Right.",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "home", "modifiers": { "mandatory": ["command"], "optional": ["shift"] } },
          "to": [{ "key_code": "up_arrow", "modifiers": ["command"] }],
          "conditions": [{ "type": "frontmost_application_unless", "bundle_identifiers": ["^com\\.github\\.wez\\.wezterm$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "end", "modifiers": { "mandatory": ["command"], "optional": ["shift"] } },
          "to": [{ "key_code": "down_arrow", "modifiers": ["command"] }],
          "conditions": [{ "type": "frontmost_application_unless", "bundle_identifiers": ["^com\\.github\\.wez\\.wezterm$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "delete_or_backspace", "modifiers": { "mandatory": ["command"] } },
          "to": [{ "key_code": "delete_or_backspace", "modifiers": ["option"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "delete_forward", "modifiers": { "mandatory": ["command"] } },
          "to": [{ "key_code": "delete_forward", "modifiers": ["option"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "left_arrow", "modifiers": { "mandatory": ["command"], "optional": ["shift"] } },
          "to": [{ "key_code": "left_arrow", "modifiers": ["option"] }],
          "conditions": [{ "type": "frontmost_application_unless", "bundle_identifiers": ["^com\\.github\\.wez\\.wezterm$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "right_arrow", "modifiers": { "mandatory": ["command"], "optional": ["shift"] } },
          "to": [{ "key_code": "right_arrow", "modifiers": ["option"] }],
          "conditions": [{ "type": "frontmost_application_unless", "bundle_identifiers": ["^com\\.github\\.wez\\.wezterm$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "home", "modifiers": { "optional": ["shift"] } },
          "to": [{ "key_code": "left_arrow", "modifiers": ["command"] }],
          "conditions": [{ "type": "frontmost_application_unless", "bundle_identifiers": ["^com\\.github\\.wez\\.wezterm$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "end", "modifiers": { "optional": ["shift"] } },
          "to": [{ "key_code": "right_arrow", "modifiers": ["command"] }],
          "conditions": [{ "type": "frontmost_application_unless", "bundle_identifiers": ["^com\\.github\\.wez\\.wezterm$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "y", "modifiers": { "mandatory": ["command"] } },
          "to": [{ "key_code": "z", "modifiers": ["command", "shift"] }],
          "conditions": [{ "type": "frontmost_application_unless", "bundle_identifiers": ["^com\\.github\\.wez\\.wezterm$"] }]
        }
      ]
    },
    {
      "description": "VS Code: Ctrl+Tab switches editors and Ctrl+` toggles the terminal (Cmd+Tab would switch apps, Cmd+` would cycle windows)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "tab", "modifiers": { "mandatory": ["command"], "optional": ["shift"] } },
          "to": [{ "key_code": "tab", "modifiers": ["control"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.microsoft\\.VSCode"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "grave_accent_and_tilde", "modifiers": { "mandatory": ["command"] } },
          "to": [{ "key_code": "grave_accent_and_tilde", "modifiers": ["control"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.microsoft\\.VSCode"] }]
        }
      ]
    },
    {
      "description": "Chrome: Ctrl+Tab and Ctrl+PgDn/PgUp switch tabs, Alt+Left/Right go back/forward, Ctrl+Shift+I/J open developer tools",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "tab", "modifiers": { "mandatory": ["command"], "optional": ["shift"] } },
          "to": [{ "key_code": "tab", "modifiers": ["control"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.google\\.Chrome$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "page_down", "modifiers": { "mandatory": ["command"] } },
          "to": [{ "key_code": "right_arrow", "modifiers": ["command", "option"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.google\\.Chrome$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "page_up", "modifiers": { "mandatory": ["command"] } },
          "to": [{ "key_code": "left_arrow", "modifiers": ["command", "option"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.google\\.Chrome$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "left_arrow", "modifiers": { "mandatory": ["option"] } },
          "to": [{ "key_code": "open_bracket", "modifiers": ["command"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.google\\.Chrome$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "right_arrow", "modifiers": { "mandatory": ["option"] } },
          "to": [{ "key_code": "close_bracket", "modifiers": ["command"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.google\\.Chrome$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "i", "modifiers": { "mandatory": ["command", "shift"] } },
          "to": [{ "key_code": "i", "modifiers": ["command", "option"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.google\\.Chrome$"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "j", "modifiers": { "mandatory": ["command", "shift"] } },
          "to": [{ "key_code": "j", "modifiers": ["command", "option"] }],
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.google\\.Chrome$"] }]
        }
      ]
    },
    {
      "description": "Windows system shortcuts: Win+Ctrl+Left/Right switches desktops, Win+Shift+S screenshots to the clipboard, Ctrl+Shift+Esc force quits, Alt+F4 quits",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "left_arrow", "modifiers": { "mandatory": ["command", "control"] } },
          "to": [{ "key_code": "left_arrow", "modifiers": ["control"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "right_arrow", "modifiers": { "mandatory": ["command", "control"] } },
          "to": [{ "key_code": "right_arrow", "modifiers": ["control"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "s", "modifiers": { "mandatory": ["control", "shift"] } },
          "to": [{ "key_code": "4", "modifiers": ["command", "control", "shift"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "escape", "modifiers": { "mandatory": ["command", "shift"] } },
          "to": [{ "key_code": "escape", "modifiers": ["command", "option"] }]
        },
        {
          "type": "basic",
          "from": { "key_code": "f4", "modifiers": { "mandatory": ["option"] } },
          "to": [{ "key_code": "q", "modifiers": ["command"] }]
        }
      ]
    }
  ]
}
